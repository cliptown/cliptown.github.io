{
  "name": "cliptown.github.io",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:site": "node scripts/check-site.mjs",
    "check:dist": "node scripts/check-site.mjs --require-dist",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "test": "npm run check:site && npm run build && npm run check:dist",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores",
    "prebuild": "npm run lint:ores"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
