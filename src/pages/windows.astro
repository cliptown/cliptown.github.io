---
import Layout from '../layouts/Layout.astro';
import PlatformPlan from '../components/PlatformPlan.astro';
---

<Layout title="ClipTown for Windows" description="ClipTown for Windows is a system-tray clipboard workspace with search, favorites, local encryption, and encrypted device sync.">
  <PlatformPlan
    name="Windows"
    icon="⊞"
    summary="A native-feeling system-tray clipboard workspace with fast search, favorites, rich previews, and trusted-device synchronization."
    capabilities={[
      'System-tray popover and configurable global keyboard shortcut.',
      'Searchable history for text, images, files, links, and rich text.',
      'Pinned favorites and retention rules for long-lived clips.',
      'Client-side encryption before cloud or peer synchronization.',
      'Windows recent-file import through explicit user selection.',
    ]}
    boundaries={[
      'Clipboard observation is opt-in and can be paused instantly.',
      'Password-manager, secure-input, and excluded applications are never intentionally captured.',
      'Windows Hello performs local step-up approval without exporting biometric data.',
      'Signed MSIX or installer artifacts must pass release CI before publication.',
    ]}
    repository="https://github.com/cliptown/cliptown-flutter"
  />
</Layout>
