---
import Layout from '../layouts/Layout.astro';
import PlatformPlan from '../components/PlatformPlan.astro';
---

<Layout title="ClipTown for Linux" description="ClipTown for Linux is a searchable clipboard workspace with pins, local encryption, and desktop-environment-aware integrations.">
  <PlatformPlan
    name="Linux"
    icon="◆"
    summary="A desktop clipboard workspace that adapts to Wayland and X11 capabilities rather than assuming every Linux session exposes the same APIs."
    capabilities={[
      'Searchable text, image, file, link, HTML, and rich-text history.',
      'Tray or desktop-shell access where the environment supports it.',
      'Pinned favorites, retention rules, and keyboard-first navigation.',
      'Client-side encryption before backend or peer synchronization.',
      'Explicit recent-file import through portal-aware file pickers.',
    ]}
    boundaries={[
      'Wayland compositors intentionally restrict global clipboard and hotkey behavior.',
      'X11 and Wayland adapters expose different capabilities and security tradeoffs.',
      'Secret Service or desktop keyrings are required for protected device-key storage.',
      'Flatpak, Snap, and AppImage packages need independent sandbox validation.',
    ]}
    repository="https://github.com/cliptown/cliptown-flutter"
  />
</Layout>
