---
import Layout from '../layouts/Layout.astro';
import PlatformPlan from '../components/PlatformPlan.astro';
---

<Layout title="ClipTown Rust CLI" description="The ClipTown Rust CLI searches, copies, pins, syncs, and diagnoses encrypted clipboard history while using ORESoftware/flags-2-env for its command contract.">
  <PlatformPlan
    name="Rust CLI"
    icon=">_"
    summary="A scriptable, keyboard-native interface for clipboard workflows in terminals, shell scripts, editors, and remote development environments."
    capabilities={[
      'List, search, inspect, copy, pin, unpin, and tombstone clips.',
      'Add text, selected files, or the current clipboard through explicit commands.',
      'Pull, push, pair, and inspect sync state across trusted devices.',
      'Emit human-readable or JSON output for automation.',
      'Run diagnostics for API, keyring, clipboard, auth, and peer-sync prerequisites.',
    ]}
    boundaries={[
      'A six-digit PIN is never accepted directly on the command line or written to shell history.',
      'Session material belongs in the operating-system keyring, not plaintext config files.',
      'Clipboard reads happen only after an explicit command.',
      'HTTPS is required for non-local endpoints.',
    ]}
    repository="https://github.com/cliptown/cliptown-cli"
  />
</Layout>
