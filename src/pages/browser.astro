---
import Layout from '../layouts/Layout.astro';
import PlatformPlan from '../components/PlatformPlan.astro';
---

<Layout title="ClipTown browser extension" description="The ClipTown browser extension saves copied content and provides consent-based draft recovery on approved sites without collecting passwords or payment fields.">
  <PlatformPlan
    name="Browser extension"
    icon="◎"
    summary="A Manifest V3 extension for browser copy history and opt-in draft rescue, designed around allowlists, redaction, local encryption, and visible controls."
    capabilities={[
      'Capture browser copy events with page-origin and content-type metadata.',
      'Preserve drafts on approved domains after explicit per-site consent.',
      'Save on blur and conservative intervals to reduce data loss.',
      'Search encrypted ClipTown history and copy results back into the page.',
      'Pause, exclude a site, delete a draft, or purge extension data instantly.',
    ]}
    boundaries={[
      'Password, payment, one-time-code, hidden, and explicitly sensitive fields are excluded.',
      'Draft rescue is off by default and enabled per domain, never globally by surprise.',
      'Content scripts receive the minimum host permissions needed for approved sites.',
      'The extension stores encrypted payloads and never logs a raw keystroke stream.',
    ]}
    repository="https://github.com/cliptown/cliptown-extension"
  />
</Layout>
