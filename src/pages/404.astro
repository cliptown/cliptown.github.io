---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found · ClipTown" description="The requested ClipTown page could not be found." noindex={true}>
  <div class="narrow">
    <section class="page-hero">
      <span class="eyebrow">404 · misplaced clip</span>
      <h1>This block is not in the <span class="gradient-text">town</span> yet.</h1>
      <p>The link may be old, the route may still be under construction, or the clipboard finally lost something.</p>
      <div class="button-row">
        <a class="button primary" href="/">Return home</a>
        <a class="button secondary" href="https://github.com/cliptown" target="_blank" rel="noopener noreferrer">Visit GitHub ↗</a>
      </div>
    </section>
  </div>
</Layout>
