---
import Layout from '../layouts/Layout.astro';

const features = [
  ['⌛', 'History without a tiny ceiling', 'Keep far more than the last 100 copied items. Retention is controlled by storage and policy, not a fixed miniature list.'],
  ['⌕', 'Search that feels immediate', 'Find text, links, images, and files by content, type, source app, recency, and favorite status.'],
  ['★', 'Pins that stay pinned', 'Keep commands, addresses, replies, images, and other reusable material in a durable favorites collection.'],
  ['⇄', 'Encrypted device sync', 'The Rust service coordinates ciphertext and conflict resolution while plaintext and account keys stay on trusted devices.'],
  ['◉', 'Offline peer continuity', 'Paired devices can exchange encrypted updates over local Wi-Fi or Bluetooth-capable transports when cloud sync is unavailable.'],
  ['✎', 'Consent-based draft rescue', 'The browser extension can preserve drafts on approved sites, exclude sensitive fields, and keep passive capture off by default.'],
];

const platforms = [
  ['/macos', '⌘', 'macOS', 'Menu-bar history, search, pins, and explicit desktop clipboard monitoring.'],
  ['/windows', '⊞', 'Windows', 'System-tray access with native clipboard integration and quick search.'],
  ['/linux', '◆', 'Linux', 'Wayland/X11-aware clipboard history with capability detection.'],
  ['/ios', '◉', 'iPhone & iPad', 'Share sheet, keyboard, Shortcuts, and intentional clipboard import.'],
  ['/android', '△', 'Android', 'Share targets, quick actions, keyboard integration, and OS-aware capture.'],
  ['/browser', '◎', 'Browser extension', 'Copy history and consent-based draft recovery for approved domains.'],
  ['/cli', '>_', 'Rust CLI', 'Search, copy, pin, sync, and diagnose ClipTown from the terminal.'],
];

const architecture = [
  ['1', 'Capture locally', 'Desktop, mobile, browser, or CLI creates a typed clip.'],
  ['2', 'Encrypt on device', 'A random account key encrypts content; the PIN unlocks wrapped key material.'],
  ['3', 'Sync ciphertext', 'Rust + SeaORM store encrypted envelopes, objects, cursors, and tombstones.'],
  ['4', 'Search privately', 'Local search is default; blind indexes and server vectors require explicit modes.'],
  ['5', 'Recover anywhere', 'Trusted devices decrypt locally and reconcile changes deterministically.'],
];
---

<Layout
  title="ClipTown — Searchable, encrypted clipboard history everywhere"
  description="ClipTown is an open-source clipboard platform with deep history, fast search, pins, end-to-end encrypted sync, local peer continuity, Flutter apps, a Rust backend, and a browser extension."
>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <span class="eyebrow">Open-source preview · active development</span>
        <h1 id="hero-title">Your clipboard is a <span class="gradient-text">place</span>, not a moment.</h1>
        <p>
          ClipTown remembers what you copied, makes it searchable, keeps important items pinned,
          and synchronizes encrypted history across the devices you trust.
        </p>
        <div class="button-row">
          <a class="button primary" href="https://github.com/cliptown/cliptown-monorepo" target="_blank" rel="noreferrer">Explore the monorepo <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="#architecture">See how it works</a>
        </div>
        <div class="hero-note">Signed production downloads will appear here only after release pipelines and platform review are complete.</div>
      </div>

      <div class="product-scene" aria-label="Illustration of the ClipTown desktop app">
        <div class="app-window">
          <div class="window-bar" aria-hidden="true">
            <span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span>
          </div>
          <div class="search-box">⌕ Search clips, images, files, and favorites…</div>
          <div class="clip-list">
            <div class="clip-row featured">
              <div class="clip-icon">★</div>
              <div class="clip-copy"><strong>Deploy checklist</strong><small>kubectl diff · dpm verify · smoke tests</small></div>
              <span class="clip-time">pinned</span>
            </div>
            <div class="clip-row">
              <div class="clip-icon">⌘</div>
              <div class="clip-copy"><strong>git switch agent/marketing-site-v2</strong><small>Terminal · 38 seconds ago</small></div>
              <span class="clip-time">now</span>
            </div>
            <div class="clip-row">
              <div class="clip-icon">▧</div>
              <div class="clip-copy"><strong>skyline-concept.png</strong><small>Image · encrypted object</small></div>
              <span class="clip-time">4m</span>
            </div>
            <div class="clip-row">
              <div class="clip-icon">↗</div>
              <div class="clip-copy"><strong>https://github.com/cliptown</strong><small>Link · shared from mobile</small></div>
              <span class="clip-time">8m</span>
            </div>
          </div>
        </div>
        <div class="sync-toast">● encrypted sync complete</div>
      </div>
    </section>

    <div class="logo-strip" aria-label="ClipTown capabilities">
      <span>Text</span><span>Images</span><span>Files</span><span>Favorites</span><span>Local search</span><span>Encrypted sync</span><span>Peer sync</span>
    </div>

    <section id="features" class="section" aria-labelledby="features-title">
      <div class="section-head">
        <div><span class="eyebrow">Built for recall</span></div>
        <div>
          <h2 id="features-title">Stop losing useful things to the next copy.</h2>
          <p>ClipTown is designed as a complete clipboard platform rather than a narrow tray utility.</p>
        </div>
      </div>
      <div class="card-grid">
        {features.map(([icon, title, body]) => (
          <article class="card">
            <div class="feature-icon" aria-hidden="true">{icon}</div>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="security-title">
      <div class="security-panel">
        <div class="security-copy">
          <span class="eyebrow">Privacy by architecture</span>
          <h2 id="security-title">The backend moves ciphertext, not your thoughts.</h2>
          <p>
            Clip content is encrypted before upload. A six-digit PIN is not used as a weak encryption key;
            it helps unlock device-protected wrapped key material. Biometrics remain local platform factors.
          </p>
          <div class="button-row">
            <a class="button secondary" href="/security">Read the security model</a>
          </div>
        </div>
        <div class="security-list">
          <div class="security-item"><strong>Local-first search</strong><span>Plaintext indexing and RAG stay on device by default.</span></div>
          <div class="security-item"><strong>Explicit server search modes</strong><span>Blind indexes and vector search are separate, opt-in privacy choices.</span></div>
          <div class="security-item"><strong>Layered authentication</strong><span>Supabase identity can be stepped up through 3FA and shared-auth integrations.</span></div>
          <div class="security-item"><strong>Reauthentication policy</strong><span>Ten days by default, configurable up to twenty days with recent step-up verification.</span></div>
        </div>
      </div>
    </section>

    <section id="platforms" class="section" aria-labelledby="platforms-title">
      <div class="section-head">
        <div><span class="eyebrow">One history, many surfaces</span></div>
        <div>
          <h2 id="platforms-title">Designed for every place you copy.</h2>
          <p>Each platform follows its operating-system rules instead of claiming impossible background access.</p>
        </div>
      </div>
      <div class="platform-grid">
        {platforms.map(([href, icon, name, body]) => (
          <a class="platform-card" href={href}>
            <div class="platform-top">
              <span class="feature-icon" aria-hidden="true">{icon}</span>
              <span class="status-pill">In development</span>
            </div>
            <h3>{name}</h3>
            <p>{body}</p>
            <span class="arrow">View platform plan →</span>
          </a>
        ))}
      </div>
    </section>

    <section id="architecture" class="section" aria-labelledby="architecture-title">
      <div class="section-head">
        <div><span class="eyebrow">System flow</span></div>
        <div>
          <h2 id="architecture-title">Local trust, durable coordination.</h2>
          <p>The product separates capture, encryption, sync, search, and recovery so privacy decisions stay explicit.</p>
        </div>
      </div>
      <div class="architecture">
        {architecture.map(([number, title, body]) => (
          <div class="arch-step">
            <span class="tag">Step {number}</span>
            <strong>{title}</strong>
            <span>{body}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="cta-panel">
        <div>
          <span class="eyebrow">Help build the town</span>
          <h2>Follow development, open an issue, or support the project.</h2>
          <p>ClipTown is being developed in public across Rust, Flutter, TypeScript, Dart, Kubernetes, and browser-extension repositories.</p>
        </div>
        <div class="button-row">
          <a class="button primary" href="https://github.com/cliptown" target="_blank" rel="noreferrer">GitHub organization ↗</a>
          <a class="button secondary" href="/support">Support options</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
