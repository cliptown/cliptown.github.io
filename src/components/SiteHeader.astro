---
import BrandMark from './BrandMark.astro';

const patreonUrl = import.meta.env.PUBLIC_PATREON_URL ?? 'https://www.patreon.com/cliptown';
---

<header class="shared-header">
  <div class="shell shared-nav">
    <a class="shared-brand" href="/" aria-label="ClipTown home"><BrandMark compact /></a>
    <nav aria-label="Primary navigation">
      <a href="/#features">Features</a>
      <a href="/security">Security</a>
      <a href="/#platforms">Platforms</a>
      <a href="/support">Support</a>
    </nav>
    <div class="shared-actions">
      <a class="github" href="https://github.com/cliptown" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a class="patreon" href={patreonUrl} target="_blank" rel="noreferrer">Patreon <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<style>
  .shared-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(104,145,235,.12);
    background: rgba(3,9,20,.84);
    backdrop-filter: blur(18px);
  }
  .shared-nav {
    min-height: 4.6rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.3rem;
  }
  .shared-brand { width: max-content; text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.5rem; }
  nav a, .shared-actions a {
    color: #90a5d0;
    text-decoration: none;
    font-size: .8rem;
    font-weight: 760;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  nav a:hover, .shared-actions a:hover { color: white; }
  .shared-actions { justify-self: end; display: flex; gap: .45rem; }
  .shared-actions a {
    display: inline-flex;
    align-items: center;
    gap: .32rem;
    padding: .55rem .75rem;
    border: 1px solid rgba(110,151,243,.2);
    border-radius: .62rem;
    background: rgba(47,107,255,.07);
  }
  .shared-actions .patreon {
    color: #ff9caf;
    border-color: rgba(255,92,120,.26);
    background: rgba(255,49,88,.08);
  }
  @media (max-width: 820px) {
    .shared-nav { grid-template-columns: 1fr auto; }
    nav { display: none; }
  }
  @media (max-width: 520px) {
    .shared-actions .github { display: none; }
    .shared-actions .patreon { font-size: .72rem; }
  }
</style>
