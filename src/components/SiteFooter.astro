---
import BrandMark from './BrandMark.astro';

const supportUrl = import.meta.env.PUBLIC_PATREON_URL?.trim();
---

<footer class="shared-footer">
  <div class="shell footer-shell">
    <div class="footer-brand">
      <a href="/" aria-label="ClipTown home"><BrandMark compact /></a>
      <p>A searchable, encrypted memory for everything you copy.</p>
    </div>
    <div class="footer-group">
      <strong>Product</strong>
      <a href="/#features">Features</a>
      <a href="/security">Security</a>
      <a href="/#platforms">Platforms</a>
    </div>
    <div class="footer-group">
      <strong>Community</strong>
      <a href="https://github.com/cliptown" target="_blank" rel="noreferrer">GitHub organization ↗</a>
      {supportUrl ? (
        <a href={supportUrl} target="_blank" rel="noreferrer">Verified support destination ↗</a>
      ) : (
        <a href="/support">Support destination pending verification</a>
      )}
      <a href="/support">Ways to support</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} ClipTown contributors.</span>
    <span>Open-source alpha · production downloads are not published yet.</span>
  </div>
</footer>

<style>
  .shared-footer {
    margin-top: 6rem;
    padding: 3.5rem 0 2rem;
    border-top: 1px solid rgba(104,145,235,.13);
    background: rgba(2,7,16,.72);
  }
  .footer-shell {
    display: grid;
    grid-template-columns: 1.4fr .7fr .9fr;
    gap: 3rem;
  }
  .footer-brand a { text-decoration: none; }
  .footer-brand p { max-width: 26rem; margin: 1rem 0 0; font-size: .85rem; }
  .footer-group { display: grid; align-content: start; gap: .65rem; }
  .footer-group strong { color: var(--ink-strong); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .footer-group a { color: var(--ink-muted); text-decoration: none; font-size: .82rem; }
  .footer-group a:hover { color: white; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(104,145,235,.11);
    color: #6f86b7;
    font-size: .7rem;
  }
  @media (max-width: 760px) {
    .footer-shell { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-shell { grid-template-columns: 1fr; }
    .footer-brand { grid-column: auto; }
    .footer-bottom { flex-direction: column; }
  }
</style>
