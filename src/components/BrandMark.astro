---
export interface Props {
	compact?: boolean;
	label?: boolean;
}

const { compact = false, label = true } = Astro.props;
---

<div class:list={['brand-mark', { compact }]} aria-label={label ? 'ClipTown' : undefined}>
	<img src="/favicon.svg" alt="" width="72" height="72" decoding="async" />
	{label && <span>ClipTown</span>}
</div>

<style>
	.brand-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 1.08rem;
		font-weight: 850;
		letter-spacing: -0.04em;
		color: var(--ink-strong);
	}

	img {
		width: 2.35rem;
		height: 2.35rem;
		flex: none;
		filter: drop-shadow(0 10px 20px rgba(15, 59, 175, 0.2));
	}

	.compact img {
		width: 1.9rem;
		height: 1.9rem;
	}
</style>
