---
export interface Props {
  name: string;
  icon: string;
  summary: string;
  capabilities: string[];
  boundaries: string[];
  repository: string;
}

const { name, icon, summary, capabilities, boundaries, repository } = Astro.props;
---

<main class="platform-main shell">
  <section class="platform-hero">
    <div class="platform-badge"><span aria-hidden="true">{icon}</span> Active development</div>
    <p class="eyebrow">Platform roadmap</p>
    <h1>ClipTown for <em>{name}</em></h1>
    <p class="lede">{summary}</p>
    <div class="actions">
      <a class="button button-primary" href={repository} target="_blank" rel="noreferrer">Follow the repository <span aria-hidden="true">↗</span></a>
      <a class="button button-secondary" href="/#platforms">View all platforms</a>
    </div>
  </section>

  <aside class="release-note">
    Signed production downloads are not available yet. This page documents the intended capability without presenting placeholder installers as real releases.
  </aside>

  <section class="plan-grid">
    <article class="plan-card surface">
      <p class="eyebrow">Planned capabilities</p>
      <ul>{capabilities.map((item) => <li>{item}</li>)}</ul>
    </article>
    <article class="plan-card surface">
      <p class="eyebrow red">Platform boundaries</p>
      <ul>{boundaries.map((item) => <li>{item}</li>)}</ul>
    </article>
  </section>

  <section class="platform-cta surface">
    <div>
      <p class="eyebrow">Help ship it</p>
      <h2>Test the assumptions, not just the interface.</h2>
      <p>Platform constraints, accessibility, security, signing, packaging, and store review are part of the product.</p>
    </div>
    <a class="button button-secondary" href={repository} target="_blank" rel="noreferrer">Open the project ↗</a>
  </section>
</main>

<style>
  .platform-main { padding-top: 5rem; padding-bottom: 2rem; }
  .platform-hero { max-width: 52rem; padding: 3.5rem 0 3rem; }
  .platform-badge {
    width: max-content;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: 1.6rem;
    padding: .45rem .7rem;
    border: 1px solid rgba(255,80,111,.22);
    border-radius: 999px;
    color: #ff9aab;
    background: rgba(255,49,88,.07);
    font-size: .7rem;
    font-weight: 780;
  }
  h1 { margin-bottom: 1.4rem; }
  h1 em {
    font-style: normal;
    color: transparent;
    background: linear-gradient(105deg,var(--red-400),var(--blue-400) 78%);
    background-clip: text;
    -webkit-background-clip: text;
  }
  .lede { max-width: 46rem; font-size: 1.15rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .release-note {
    margin: 0 0 1rem;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(255,92,120,.25);
    border-radius: .8rem;
    color: #ffb5c2;
    background: rgba(255,49,88,.07);
    font-size: .82rem;
    line-height: 1.65;
  }
  .plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 2rem 0 5rem; }
  .plan-card { min-height: 24rem; padding: 2rem; border-radius: 1.1rem; }
  .eyebrow.red { color: var(--red-300); }
  .plan-card ul { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .plan-card li {
    position: relative;
    padding: 0 0 1rem 1.4rem;
    border-bottom: 1px solid rgba(104,145,235,.12);
    color: var(--ink-muted);
    line-height: 1.62;
  }
  .plan-card li::before { content: '◆'; position: absolute; left: 0; color: var(--blue-400); font-size: .6rem; top: .35rem; }
  .plan-card:nth-child(2) li::before { color: var(--red-400); }
  .platform-cta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
    padding: clamp(1.5rem,4vw,3rem);
    border-radius: 1.2rem;
  }
  .platform-cta h2 { max-width: 42rem; font-size: clamp(2rem,4vw,3.4rem); }
  .platform-cta p:last-child { max-width: 42rem; margin-bottom: 0; }
  @media (max-width: 760px) {
    .platform-main { padding-top: 2rem; }
    .plan-grid, .platform-cta { grid-template-columns: 1fr; }
    .plan-card { min-height: auto; }
  }
</style>
