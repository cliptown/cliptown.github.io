---
const clips = [
	{ type: 'TEXT', title: 'Launch checklist', body: 'Rotate secrets · run migrations · verify health checks', time: 'Now', pinned: true },
	{ type: 'LINK', title: 'Declarative migrations', body: 'github.com/declarative-migrations', time: '4m', pinned: false },
	{ type: 'IMAGE', title: 'ClipTown skyline concept', body: 'PNG · 2048 × 2048 · 1.8 MB', time: '12m', pinned: false },
];
---

<div class="preview-shell" aria-label="Concept preview of the ClipTown desktop application">
	<div class="window-bar">
		<div class="traffic" aria-hidden="true"><span></span><span></span><span></span></div>
		<div class="window-title">ClipTown</div>
		<div class="sync-state"><span></span> Synced</div>
	</div>

	<div class="preview-body">
		<aside>
			<button class="side-action active" type="button" aria-label="All clips">
				<span class="side-icon">⌘</span><span>All clips</span><strong>2,847</strong>
			</button>
			<button class="side-action" type="button" aria-label="Pinned clips">
				<span class="side-icon">◆</span><span>Pinned</span><strong>32</strong>
			</button>
			<button class="side-action" type="button" aria-label="Images">
				<span class="side-icon">▧</span><span>Images</span><strong>184</strong>
			</button>
			<button class="side-action" type="button" aria-label="Files">
				<span class="side-icon">▤</span><span>Files</span><strong>61</strong>
			</button>
			<div class="device-card">
				<span class="device-pulse"></span>
				<div><b>3 devices</b><small>Peer sync ready</small></div>
			</div>
		</aside>

		<section class="clip-panel">
			<div class="search-box">
				<span aria-hidden="true">⌕</span>
				<span class="search-copy">Search 2,847 clips…</span>
				<kbd>⌘ K</kbd>
			</div>
			<div class="filter-row">
				<span class="filter active">Recent</span>
				<span class="filter">Pinned</span>
				<span class="filter">Semantic</span>
				<span class="privacy-pill">Encrypted locally</span>
			</div>

			<div class="clip-list">
				{clips.map((clip, index) => (
					<article class:list={['clip-row', { selected: index === 0 }]}>
						<div class:list={['clip-type', clip.type.toLowerCase()]}>{clip.type.slice(0, 1)}</div>
						<div class="clip-copy">
							<div class="clip-heading"><b>{clip.title}</b>{clip.pinned && <span title="Pinned">◆</span>}</div>
							<p>{clip.body}</p>
						</div>
						<time>{clip.time}</time>
					</article>
				))}
			</div>

			<div class="command-bar">
				<div><kbd>↵</kbd> Copy</div>
				<div><kbd>⌘</kbd><kbd>1</kbd> Pin</div>
				<div><kbd>⌫</kbd> Delete</div>
				<span>End-to-end encrypted</span>
			</div>
		</section>
	</div>
</div>

<style>
	.preview-shell {
		position: relative;
		width: min(100%, 690px);
		border: 1px solid rgba(114, 155, 255, 0.25);
		border-radius: 1.35rem;
		background: rgba(7, 18, 41, 0.94);
		box-shadow: 0 45px 110px rgba(0, 18, 70, 0.48), 0 0 0 1px rgba(255, 255, 255, 0.035) inset;
		overflow: hidden;
		transform: perspective(1200px) rotateY(-3deg) rotateX(1deg);
		transform-origin: center;
	}

	.preview-shell::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(115deg, rgba(255,255,255,.055), transparent 28%);
		pointer-events: none;
		z-index: 3;
	}

	.window-bar {
		height: 3.15rem;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0 1rem;
		border-bottom: 1px solid rgba(129, 160, 232, 0.15);
		background: rgba(10, 27, 62, 0.74);
		color: #9eb4e5;
		font-size: 0.72rem;
	}

	.traffic { display: flex; gap: .38rem; }
	.traffic span { width: .62rem; height: .62rem; border-radius: 999px; background: #ff3f63; }
	.traffic span:nth-child(2) { background: #ffbd4a; }
	.traffic span:nth-child(3) { background: #33d17a; }
	.window-title { font-weight: 700; color: #dce7ff; }
	.sync-state { justify-self: end; display: flex; align-items: center; gap: .4rem; }
	.sync-state span { width: .43rem; height: .43rem; border-radius: 50%; background: #38df96; box-shadow: 0 0 10px #38df96; }

	.preview-body { display: grid; grid-template-columns: 11.5rem minmax(0, 1fr); min-height: 30rem; }
	aside { padding: 1rem .7rem; border-right: 1px solid rgba(129,160,232,.13); background: rgba(5, 15, 35, .62); display: flex; flex-direction: column; gap: .3rem; }
	.side-action { appearance: none; border: 0; width: 100%; display: grid; grid-template-columns: 1.6rem 1fr auto; align-items: center; gap: .45rem; padding: .67rem .7rem; color: #8da6dc; background: transparent; border-radius: .65rem; text-align: left; font: inherit; font-size: .72rem; }
	.side-action strong { color: #5871a7; font-size: .65rem; font-weight: 650; }
	.side-action.active { color: white; background: linear-gradient(100deg, rgba(47,107,255,.26), rgba(47,107,255,.08)); box-shadow: inset 3px 0 #3977ff; }
	.side-icon { color: #6f91df; text-align: center; }
	.device-card { margin-top: auto; display: flex; align-items: center; gap: .55rem; padding: .75rem; border-radius: .75rem; background: rgba(47,107,255,.08); border: 1px solid rgba(80,127,239,.17); }
	.device-card b, .device-card small { display: block; }
	.device-card b { color: #d9e5ff; font-size: .7rem; }
	.device-card small { color: #6f88bc; font-size: .58rem; margin-top: .12rem; }
	.device-pulse { width: .55rem; height: .55rem; background: #ff3158; border-radius: 50%; box-shadow: 0 0 0 5px rgba(255,49,88,.12); }

	.clip-panel { padding: 1rem; min-width: 0; display: flex; flex-direction: column; }
	.search-box { display: grid; grid-template-columns: auto 1fr auto; gap: .65rem; align-items: center; min-height: 2.65rem; padding: 0 .8rem; border-radius: .72rem; border: 1px solid rgba(108,145,232,.24); background: rgba(13,31,70,.82); color: #6f8bc8; font-size: .72rem; }
	.search-copy { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
	kbd { display: inline-grid; place-items: center; min-width: 1.4rem; height: 1.35rem; padding: 0 .3rem; border: 1px solid rgba(139,168,235,.25); border-bottom-color: rgba(139,168,235,.38); border-radius: .32rem; background: rgba(255,255,255,.035); color: #90a9dd; font: inherit; font-size: .58rem; }
	.filter-row { display: flex; align-items: center; gap: .35rem; padding: .8rem 0 .65rem; }
	.filter { color: #6f88bc; font-size: .61rem; padding: .36rem .56rem; border-radius: 999px; }
	.filter.active { color: #dbe6ff; background: rgba(47,107,255,.18); }
	.privacy-pill { margin-left: auto; color: #ff8ca1; border: 1px solid rgba(255,49,88,.22); background: rgba(255,49,88,.07); padding: .34rem .55rem; border-radius: 999px; font-size: .56rem; }
	.clip-list { display: flex; flex-direction: column; gap: .48rem; }
	.clip-row { display: grid; grid-template-columns: 2.45rem minmax(0,1fr) auto; align-items: center; gap: .7rem; padding: .72rem; border: 1px solid rgba(105,142,222,.11); border-radius: .75rem; background: rgba(10,25,57,.58); }
	.clip-row.selected { border-color: rgba(59,119,255,.38); background: linear-gradient(95deg, rgba(36,85,199,.23), rgba(12,29,65,.72)); }
	.clip-type { width: 2.35rem; height: 2.35rem; display: grid; place-items: center; border-radius: .62rem; color: white; font-size: .67rem; font-weight: 850; background: #2f6bff; }
	.clip-type.link { background: #ff3158; }
	.clip-type.image { background: linear-gradient(135deg, #2f6bff, #9f54ff); }
	.clip-heading { display: flex; align-items: center; gap: .4rem; min-width: 0; color: #e5edff; font-size: .7rem; }
	.clip-heading b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.clip-heading span { color: #ff4868; font-size: .55rem; }
	.clip-copy { min-width: 0; }
	.clip-copy p { margin: .24rem 0 0; color: #7890c3; font-size: .6rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.clip-row time { color: #586f9f; font-size: .56rem; }
	.command-bar { margin-top: auto; padding-top: .75rem; display: flex; align-items: center; gap: .7rem; color: #6077aa; font-size: .56rem; }
	.command-bar > div { display: flex; align-items: center; gap: .28rem; }
	.command-bar > span { margin-left: auto; color: #5977bb; }

	@media (max-width: 720px) {
		.preview-shell { transform: none; }
		.preview-body { grid-template-columns: 1fr; min-height: 26rem; }
		aside { display: none; }
		.command-bar > div:nth-child(2), .command-bar > div:nth-child(3) { display: none; }
	}
</style>
