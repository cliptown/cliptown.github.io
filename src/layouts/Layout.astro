---
import '../styles/global.css';
import { supportUrl } from '../lib/support';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'ClipTown is an open-source, encrypted clipboard history and sync platform for desktop, mobile, browsers, and the command line.',
  image = '/logo.jpg',
  noindex = false,
} = Astro.props;

// DEN-58: no fallback funding URL. An external support destination appears
// only when PUBLIC_PATREON_URL is explicitly configured after ownership verification.
const supportUrl = import.meta.env.PUBLIC_PATREON_URL?.trim();

const site = Astro.site ?? new URL('https://cliptown.github.io');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(image, site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ClipTown',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS, Windows, Linux, iOS, Android, Web',
  description,
  url: site.toString(),
  codeRepository: 'https://github.com/cliptown',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/PreOrder',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a12" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ClipTown" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="ClipTown home">
          <img src="/brand-mark.svg" alt="" width="38" height="38" />
          <span>ClipTown</span>
          <small>clipboard infrastructure</small>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/#features">Features</a>
          <a href="/#platforms">Platforms</a>
          <a href="/security">Security</a>
          <a href="/support">Support</a>
          <a class="button compact secondary" href="https://github.com/cliptown" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/">
              <img src="/brand-mark.svg" alt="" width="38" height="38" />
              <span>ClipTown</span>
            </a>
            <p class="prose">Open-source clipboard history, search, encrypted sync, and peer-to-peer continuity. The project is under active development.</p>
          </div>
          <div class="footer-links">
            <strong>Product</strong>
            <a href="/#features">Features</a>
            <a href="/#platforms">Platforms</a>
            <a href="/security">Security model</a>
            <a href="/support">Support the project</a>
          </div>
          <div class="footer-links">
            <strong>Community</strong>
            <a href="https://github.com/cliptown" target="_blank" rel="noreferrer">GitHub organization ↗</a>
            <a href="https://github.com/cliptown/cliptown-monorepo" target="_blank" rel="noreferrer">Monorepo ↗</a>
            {supportUrl ? (
              <a href={supportUrl} target="_blank" rel="noreferrer">Verified support destination ↗</a>
            ) : (
              <a href="/support">Support destination pending verification</a>
            )}
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} ClipTown contributors.</span>
          <span>No production downloads are advertised until signed releases exist.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
